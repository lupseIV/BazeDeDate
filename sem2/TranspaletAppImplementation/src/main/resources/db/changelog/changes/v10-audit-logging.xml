<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">



    <changeSet id="v10-audit-palletttrucks" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="PalletTrucks" columnName="created_at"/></not>
        </preConditions>

        <addColumn tableName="PalletTrucks">
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME2" defaultValueComputed="GETDATE()">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropDefaultValue tableName="PalletTrucks" columnName="updated_at" columnDataType="DATETIME2"/>
            <dropDefaultValue tableName="PalletTrucks" columnName="created_at" columnDataType="DATETIME2"/>
            <dropColumn tableName="PalletTrucks">
                <column name="updated_at"/>
                <column name="created_at"/>
            </dropColumn>
        </rollback>
    </changeSet>

    <changeSet id="v10-audit-rentals" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="Rentals" columnName="created_at"/></not>
        </preConditions>

        <addColumn tableName="Rentals">
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME2" defaultValueComputed="GETDATE()">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropDefaultValue tableName="Rentals" columnName="updated_at" columnDataType="DATETIME2"/>
            <dropDefaultValue tableName="Rentals" columnName="created_at" columnDataType="DATETIME2"/>
            <dropColumn tableName="Rentals">
                <column name="updated_at"/>
                <column name="created_at"/>
            </dropColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
