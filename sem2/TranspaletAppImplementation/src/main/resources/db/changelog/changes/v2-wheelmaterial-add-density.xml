<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v2-wheelmaterial-add-density" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="WheelMaterials" columnName="density"/>
            </not>
        </preConditions>

        <addColumn tableName="WheelMaterials">
            <column name="density" type="DECIMAL(10,4)" defaultValueNumeric="0.0000">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <!--
                dropDefaultValue resolves the auto-generated DEFAULT constraint name
                (e.g. DF__WheelMaterials__density__XXXX) and drops it before dropColumn.
                Without this step SQL Server raises "object is dependent on column".
            -->
            <dropDefaultValue tableName="WheelMaterials" columnName="density" columnDataType="DECIMAL(10,4)"/>
            <dropColumn tableName="WheelMaterials" columnName="density"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
