<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v3-new-table-rentals" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="Rentals"/>
            </not>
        </preConditions>

        <createTable tableName="Rentals">
            <column name="rental_id" type="UNIQUEIDENTIFIER" defaultValueComputed="NEWSEQUENTIALID()">
                <constraints primaryKey="true" primaryKeyName="PK_Rentals" nullable="false"/>
            </column>
            <column name="truck_id" type="UNIQUEIDENTIFIER">
                <constraints nullable="false"
                             foreignKeyName="FK_Rentals_Trucks"
                             references="PalletTrucks(truck_id)"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE"/>
            <column name="daily_rate" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_cost" type="DECIMAL(10,2)"/>
            <column name="return_status" type="VARCHAR(255)">
                <constraints nullable="false"
                             checkConstraint="return_status IN ('Active', 'Returned', 'Overdue')"/>
            </column>
        </createTable>

        <rollback>
            <!-- dropTable is enough — it cascades and removes all constraints on the table. -->
            <dropTable tableName="Rentals"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
