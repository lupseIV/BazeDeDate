<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v6-add-indexes" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_pallettrucks_serial_number" tableName="PalletTrucks"/>
            </not>
            <not>
                <indexExists indexName="idx_rentals_truck_id" tableName="Rentals"/>
            </not>
        </preConditions>
        <sql>
            CREATE INDEX idx_pallettrucks_serial_number ON PalletTrucks(serial_number);
            CREATE INDEX idx_rentals_truck_id ON Rentals(truck_id);
        </sql>
        <rollback>
            <sql>
                DROP INDEX idx_pallettrucks_serial_number ON PalletTrucks;
                DROP INDEX idx_rentals_truck_id ON Rentals;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="v6-add-indexes-mail" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_employees_email" tableName="employees"/>
            </not>
        </preConditions>
        <sql>
            CREATE INDEX idx_employees_email ON employees(email);
        </sql>
        <rollback>
            <sql>
                DROP INDEX idx_employees_email ON employees;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>