<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="v6-idx-pallettrucks-serial-number" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_pallettrucks_serial_number" tableName="PalletTrucks"/>
            </not>
        </preConditions>

        <createIndex indexName="idx_pallettrucks_serial_number" tableName="PalletTrucks">
            <column name="serial_number"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_pallettrucks_serial_number" tableName="PalletTrucks"/>
        </rollback>
    </changeSet>

    <changeSet id="v6-idx-rentals-truck-id" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_rentals_truck_id" tableName="Rentals"/>
            </not>
        </preConditions>

        <createIndex indexName="idx_rentals_truck_id" tableName="Rentals">
            <column name="truck_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_rentals_truck_id" tableName="Rentals"/>
        </rollback>
    </changeSet>

    <changeSet id="v6-idx-employees-email" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_employees_email" tableName="Employees"/>
            </not>
        </preConditions>

        <createIndex indexName="idx_employees_email" tableName="Employees">
            <column name="email"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_employees_email" tableName="Employees"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
