<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="0" author="admin">

        <addColumn tableName="Bearings">
            <column name="version" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>

            <dropDefaultValue tableName="Bearings" columnName="version" columnDataType="INT"/>
            <dropColumn tableName="Bearings" columnName="version"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
