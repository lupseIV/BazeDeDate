<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="v9-add-capacity-tons-column" author="lupse">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="PalletTrucks" columnName="capacity_tons"/>
            </not>
        </preConditions>

        <addColumn tableName="PalletTrucks">
            <column name="capacity_tons" type="DECIMAL(10,3)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="PalletTrucks" columnName="capacity_tons"/>
        </rollback>
    </changeSet>

    <changeSet id="v9-migrate-capacity-kg-to-tons" author="lupse">
        <sql>
            UPDATE PalletTrucks
            SET capacity_tons = CAST(capacity_kg AS DECIMAL(10, 3)) / 1000.0
            WHERE capacity_tons IS NULL;
        </sql>

        <rollback>
            <sql>UPDATE PalletTrucks SET capacity_tons = NULL;</sql>
        </rollback>
    </changeSet>

    <changeSet id="v9-set-capacity-tons-not-null" author="lupse">
        <addNotNullConstraint tableName="PalletTrucks"
                              columnName="capacity_tons"
                              columnDataType="DECIMAL(10,3)"/>

        <rollback>
            <dropNotNullConstraint tableName="PalletTrucks"
                                   columnName="capacity_tons"
                                   columnDataType="DECIMAL(10,3)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
